        "$ref": "#/$defs/major_achievement"
      },
      "default": []
    },
    "biography_summary": {
      "type": [
        "string",
        "null"
      ],
      "description": "Brief biographical summary paragraph"
    },
    "profile": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "description": "Photo/logo image reference",
      "properties": {
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "description": "Original image URL (e.g. Wikipedia/Wikidata)"
        },
        "local_path": {
          "type": [
            "string",
            "null"
          ],
          "description": "Local downloaded path relative to output dir, e.g. photos/SG-PERSON-000005.jpg"
        }
      }
    },
    "collection_meta": {
