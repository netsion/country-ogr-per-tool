{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://apec-osint-tool.org/schemas/person_profile.json",
  "title": "APEC OSINT Person Profile",
  "description": "Phase 6 person profile schema for a single person",
  "type": "object",
  "required": [
    "person_id",
    "name",
    "name_en",
    "nationality",
    "gender"
  ],
  "additionalProperties": false,
  "properties": {
    "person_id": {
      "type": "string",
      "pattern": "^[A-Z]{2}-PERSON-[0-9]{6}$",
      "description": "Unique person identifier: {ISO2}-PERSON-{SEQ(6-digit)}",
      "examples": [
        "SG-PERSON-000001"
      ]
    },
    "wikidata_qid": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^Q[0-9]+$",
      "examples": [
        "Q57643"
      ]
    },
    "name_zh": {
      "type": [
        "string",
        "null"
      ],
      "examples": [
        "黄循财"
      ]
    },
    "name": {
      "type": "string",
      "description": "Name in the person's native/primary language",
      "examples": [
        "黄循财",
        "K. Shanmugam"
      ]
    },
    "name_en": {
      "type": "string",
      "examples": [
        "Lawrence Wong"
      ]
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Alternative names, nicknames, transliterations"
    },
    "nationality": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "examples": [
        "SG"
      ]
    },
    "gender": {
      "$ref": "#/$defs/gender_enum"
    },
    "birth_date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Full date in YYYY-MM-DD format. Use -01 for unknown month/day."
    },
    "birth_place": {
      "type": [
        "string",
        "null"
      ],
      "examples": [
        "Singapore"
      ]
    },
    "contacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contact"
      },
      "default": []
    },
    "current_positions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "List of current position titles"
    },
    "education": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/education_entry"
      },
      "default": []
    },
    "work_experience": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/work_experience_entry"
      },
      "default": []
    },
    "person_relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/person_relationship"
      },
      "default": []
    },
    "social_accounts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/social_account"
      },
      "default": []
    },
    "family_members": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/family_member"
      },
      "default": []
    },
    "political_stances": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/political_stance"
      },
      "default": []
    },
    "major_achievements": {
      "type": "array",
