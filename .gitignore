# Output cache files (keep structure, ignore cache blobs)
output/**/_cache/

# Python cache
__pycache__/
*.pyc
*.pyo

# Temp files
*.tmp
*.stackdump
=0.*

# IDE
.vscode/
.idea/

# OS
Thumbs.db
.DS_Store

# Large JSON queues
enrichment_queue.json
missing_persons_queue.json
remaining_persons.json

# MCP config (may contain API keys)
.mcp.json
.agents/mcp.json

# Claude settings (local)
.claude/settings.local.json

# Avatar image store (2.2GB local mirror of MinIO bucket; keys tracked in profile.minio_path)
minio-store/

# MinIO upload kit artifacts (transfer-only, not source)
minio-upload-kit.tar
minio-increment-20.tar
upload_state.json

# Avatar pipeline working state / trash (regenerable)
output/_avatar_audit/

# No dataset images in git (canonical image store is minio-store/, ignored above)
output/**/*.jpg
output/**/*.jpeg
output/**/*.png
output/**/*.gif
output/**/*.webp
output/**/*.svg
output/**/*.avif
output/**/*.ico

# Workspace hygiene (see .agents/skills/country-org-collector/workspace-hygiene.md)
output/**/_tmp/
output/**/tmp/
output/**/wiki/
output/**/_raw/
output/**/_avtmp/
