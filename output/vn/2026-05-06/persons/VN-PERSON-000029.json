  "political_stances": [
    {
      "date": "2024-01",
      "topic": "越南制造业与全球化",
      "stance_content": "通过押注VinFast电动汽车全球化，推动越南从低端制造业向高科技产业转型。主张越南企业应打造全球化品牌，在国际舞台上与特斯拉等巨头竞争。投入超过100亿美元发展电动汽车产业，展现对越南制造业未来的信心。",
      "source": "https://www.forbes.com/sites/jonathanburgos/2023/11/07/vietnams-richest-person-bets-over-10-billion-to-break-into-the-global-ev-market/"
