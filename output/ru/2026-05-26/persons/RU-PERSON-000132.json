  "political_stances": [
    {
      "date": "2012-06",
      "topic": "科技创新与产业政策",
      "stance_content": "格里申认为机器人技术将像个人电脑和互联网一样深刻改变日常生活，批评俄罗斯过度依赖能源出口而忽视科技创新的产业政策，主张通过私人资本推动全球机器人生态系统的发展。他在创办Grishin Robotics时选择在硅谷而非俄罗斯设立总部，反映了对俄罗斯创业环境的保留态度。",
      "source": "https://en.wikipedia.org/wiki/Dmitry_Grishin"
    },
    {
      "date": "2022-05",
      "topic": "俄乌冲突与企业治理",
      "stance_content": "2022年5月，格里申在俄乌冲突爆发后正式辞去VK（原Mail.ru集团）董事会主席和非执行董事职务，被视为与俄罗斯政治环境保持距离的信号。此后他将主要精力转向Grishin Robotics的国际投资业务。",
      "source": "https://ru.wikipedia.org/wiki/%D0%93%D1%80%D0%B8%D1%88%D0%B8%D0%BD,_%D0%94%D0%BC%D0%B8%D1%82%D1%80%D0%B8%D0%B9_%D0%A1%D0%B5%D1%80%D0%B3%D0%B5%D0%B5%D0%B2%D0%B8%D1%87"
