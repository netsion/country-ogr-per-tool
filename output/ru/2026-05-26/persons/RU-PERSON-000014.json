  "political_stances": [
    {
      "date": "2022-03-04",
      "topic": "俄罗斯对乌克兰军事行动",
      "stance_content": "萨多夫尼奇作为俄罗斯校长联盟主席，牵头签署了一份由305名大学校长联名的公开信，支持俄罗斯对乌克兰的军事行动，信中呼吁「去军事化和去纳粹化乌克兰」，要求「支持军队和总统」。因此被乌克兰实施个人制裁，并被剥夺基辅大学、哈尔科夫大学和第聂伯大学荣誉教授称号",
      "source": "https://en.wikipedia.org/wiki/Viktor_Sadovnichiy"
    },
    {
      "date": "2002",
      "topic": "博洛尼亚进程与高等教育改革",
      "stance_content": "萨多夫尼奇对俄罗斯加入博洛尼亚进程持批评态度，认为俄罗斯理工科和自然科学教育体系已经是最佳的，引入两级（本科+硕士）制可能破坏已形成的科学学派。他反对强制性改革，主张高校自主决定",
      "source": "https://ru.wikipedia.org/wiki/%D0%A1%D0%B0%D0%B4%D0%BE%D0%B2%D0%BD%D0%B8%D1%87%D0%B8%D0%B9,_%D0%92%D0%B8%D0%BA%D1%82%D0%BE%D1%80_%D0%90%D0%BD%D1%82%D0%BE%D0%BD%D0%BE%D0%B2%D0%B8%D1%87"
    },
    {
      "date": "2006",
      "topic": "统一国家考试（ЕГЭ）",
      "stance_content": "萨多夫尼奇多次公开反对以统一国家考试成绩作为大学录取的唯一标准，认为该考试存在太多偶然因素。他坚持莫斯科大学应保留自主入学考试的权利，最终促成部分顶尖大学获得通过奥林匹亚竞赛等方式录取学生的例外权",
      "source": "https://ru.wikipedia.org/wiki/%D0%A1%D0%B0%D0%B4%D0%BE%D0%B2%D0%BD%D0%B8%D1%87%D0%B8%D0%B9,_%D0%92%D0%B8%D0%BA%D1%82%D0%BE%D1%80_%D0%90%D0%BD%D1%82%D0%BE%D0%BD%D0%BE%D0%B2%D0%B8%D1%87"
    }
  ],
