7\u0646=MENA: reserve military personnel by country 2024 {{!}} Statista|\u0645\u0633\u0627\u0631=https://www.statista.com/statistics/958319/mena-reserve-military-personnel-by-country/|\u062a\u0627\u0631\u064a\u062e-\u0627\u0644\u0648\u0635\u0648\u0644=2025-01-18|\u0635\u062d\u064a\u0641\u0629=Statista|\u0644\u063a\u0629=en|\u062a\u0627\u0631\u064a\u062e-\u0627\u0644\u0623\u0631\u0634\u064a\u0641=30 \u062f\u064a\u0633\u0645\u0628\u0631 2024|\u0645\u0633\u0627\u0631-\u0627\u0644\u0623\u0631\u0634\u064a\u0641=https://web.archive.org/web/20241230155451/https://www.statista.com/statistics/958319/mena-reserve-military-personnel-by-country/|url-status=live}}</ref>\n| \u0645\u064a\u0632\u0627\u0646\u064a\u0629 =\n1.913 \u0645\u0644\u064a\u0627\u0631 [[\u062f\u0648\u0644\u0627\u0631 \u0623\u0645\u0631\u064a\u0643\u064a]] (2010\u060c \u0644\u0627 \u062a\u0648\u062c\u062f \u0628\u064a\u0627\u0646\u0627\u062a \u0628\u0639\u062f \u0630\u0644\u0643)<ref>{{\u0627\u0633\u062a\u0634\u0647\u0627\u062f \u0628\u0648\u064a\u0628|\u0639\u0646\u0648\u0627\u0646=\"Military spending and arms imports by Iran, Qatar and the United Arab Emirates\"|\u0645\u0633\u0627\u0631=https://www.sipri.org/sites/default/files/2019-05/fs_1905_gulf_milex_and_arms_transfers.pdf|\u062a\u0627\u0631\u064a\u062e-\u0627\u0644\u0648\u0635\u0648\u0644=18 \u064a\u0646\u0627\u064a\u0631 2025|\u0635\u062d\u064a\u0641\u0629=\u0645\u0639\u0647\u062f \u0633\u062a\u0648\u0643\u0647\u0648\u0644\u0645 \u0644\u0623\u0628\u062d\u0627\u062b \u0627\u0644\u0633\u0644\u0627\u0645|\u062a\u0627\u0631\u064a\u062e=2019|\u0645\u0624\u0644\u0641=Wezeman, Peter|\u0645\u0633\u0627\u0631 \u0623\u0631\u0634\u064a\u0641=http://web.archive.org/web/20260410055155/https://www.sipri.org/sites/default/files/2019-05/fs_1905_gulf_milex_and_arms_transfers.pdf|\u062a\u0627\u0631\u064a\u062e \u0623\u0631\u0634\u064a\u0641=2026-04-10}}</ref>\n| \u0627\u0644\u0646\u0627\u062a\u062c = 2.5% (2016)\n<!--\u0627\u0644\u0635\u0646\u0627\u0639\u0629 -->| \u0645\u0648\u0631\u062f \u0645\u062d\u0644\u064a = \u0634\u0631\u0643\u0629 \u0628\u0631\u0632\u0627\u0646 \u0627\u0644\u0642\u0627\u0628\u0636\u0629\n| \u0645\u0648\u0631\u062f \u062e\u0627\u0631\u062c\u064a = {{\u0639\u0644\u0645 \u0627\u0644\u0648\u0644\u0627\u064a\u0627\u062a \u0627\u0644\u0645\u062a\u062d\u062f\u0629}} <br /> {{\u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u0627\u0644\u0645\u062a\u062d\u062f\u0629}} <br/> {{\u0641\u0631\u0646\u0633\u0627}} <br/> {{\u062a\u0631\u0643\u064a\u0627}} <br/> {{\u0639\u0644\u0645 \u0623\u0644\u0645\u0627\u0646\u064a\u0627}} <br/> {{\u0631\u0648\u0633\u064a\u0627}} <br/> {{\u0627\u0644\u0635\u064a\u0646}}<br/>{{\u0623\u0633\u062a\u0631\u0627\u0644\u064a\u0627}}<br/>{{\u0627\u0644\u0628\u0631\u0627\u0632\u064a\u0644}}<br/>{{\u0643\u0646\u062f\u0627}}\n| \u0648\u0627\u0631\u062f\u0627\u062a = \n| \u0635\u0627\u062f\u0631\u0627\u062a = <!--\u0645\u0642\u0627\u0644\u0627\u062a \u0630\u0627\u062a \u0635\u0644\u0629 -->\n| \u0627\u0644\u062a\u0627\u0631\u064a\u062e = [[\u062d\u0631\u0628 \u0627\u0644\u062e\u0644\u064a\u062c \u0627\u0644\u062b\u0627\u0646\u064a\u0629]] <br/> [[\u062a\u062f\u062e\u0644 \u0642\u0648\u0627\u062a \u062f\u0631\u0639 \u0627\u0644\u062c\u0632\u064a\u0631\u0629 \u0641\u064a \u0627\u0644\u0628\u062d\u0631\u064a\u0646|\u0627\u0644\u062a\u062f\u062e\u0644 \u0641\u064a \u0627\u0644\u0628\u062d\u0631\u064a\u0646]] <br/> [[\u0627\u0644\u062a\u062f\u062e\u0644 \u0627\u0644\u0639\u0633\u0643\u0631\u064a \u0641\u064a \u0644\u064a\u0628\u064a\u0627]] <br />   [[\u0627\u0644\u062a\u062f\u062e\u0644 \u0628\u0642\u064a\u0627\u062f\u0629 \u0627\u0644\u0648\u0644\u0627\u064a\u0627\u062a \u0627\u0644\u0645\u062a\u062d\u062f\u0629 \u0641\u064a \u0633\u0648\u0631\u064a\u0627|\u0627\u0644\u062a\u062f\u062e\u0644 \u0641\u064a \u0633\u0648\u0631\u064a\u0627]] <br/> [[\u0639\u0645\u0644\u064a\u0629 \u0639\u0627\u0635\u0641\u0629 \u0627\u0644\u062d\u0632\u0645]] <br /> [[\u0639\u0645\u0644\u064a\u0629 \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0623\u0645\u0644]]\n}}'''\u0627\u0644\u0642\u0648\u0627\u062a \u0627\u0644\u0645\u0633\u0644\u062d\u0629 \u0627\u0644\u0642\u0637\u0631\u064a\u0629''' \u0647\u064a \u0627\u0644\u062c\u064a\u0634 \u0627\u0644\u0646\u0638\u0627\u0645\u064a [[\u0642\u0637\u0631|\u0644\u0640\u062f\u0648\u0644\u0629 \u0642\u0637\u0631]]\u060c \u0645\u0646\u0630 \u0639\u0627\u0645 2015\u060c \u0646\u0641\u0630\u062a \u0642\u0637\u0631 \u0627\u0644\u062a\u062c\u0646\u064a\u062f \u0627\u0644\u0639\u0633\u0643\u0631\u064a \u0627\u0644\u0625\u0644\u0632\u0627\u0645\u064a \u0628\u0645\u0639\u062f\u0644 2000 \u062e\u0631\u064a\u062c \u0633\u0646\u0648\u064a\u064b\u0627\u060c<ref>{{\u0627\u0633\u062a\u0634\u0647\u0627\u062f \u0628\u0648\u064a\u0628|\u0639\u0646\u0648\u0627\u0646=Qatar's National Service Program Puts New Focus on Military Training\"|\u0645\u0633\u0627\u0631=https://dohanews.co/qatars-national-service-program-puts-new-emphasis-on-military-training/amp/|\u062a\u0627\u0631\u064a\u062e-\u0627\u0644\u0648\u0635\u0648\u0644=18 \u064a\u0646\u0627\u064a\u0631 2025|\u0645\u0633\u0627\u0631 \u0623\u0631\u0634\u064a\u0641=http://web.archive.org/web/20190525235411/https://dohanews.co/qatars-national-service-program-puts-new-emphasis-on-military-training/amp/|\u062a\u0627\u0631\u064a\u062e \u0623\u0631\u0634\u064a\u0641=2019-05-25}}</ref> \u0648\u0627\u0639\u062a\u0628\u0627\u0631\u064b\u0627 \u0645\u0646 \u0639\u0627\u0645 2010\u060c \u0628\u0644\u063a \u0625\u062c\u0645\u0627\u0644\u064a \u0646\u0641\u0642\u0627\u062a \u0627\u0644\u062f\u0641\u0627\u0639 \u0641\u064a \u0642\u0637\u0631 1.913 \u0645\u0644\u064a\u0627\u0631 \u062f\u0648\u0644\u0627\u0631\u060c \u0623\u064a \u062d\u0648\u0627\u0644\u064a 1.5\u066a \u0645\u0646 [[\u0646\u0627\u062a\u062c \u0642\u0648\u0645\u064a \u0625\u062c\u0645\u0627\u0644\u064a|\u0627\u0644\u0646\u0627\u062a\u062c \u0627\u0644\u0642\u0648\u0645\u064a]].<ref>{{\u0627\u0633\u062a\u0634\u0647\u0627\u062f \u0628\u0648\u064a\u0628|\u0639\u0646\u0648\u0627\u0646=Domain Default page|\u0645\u0633\u0627\u0631=http://milexdata.sipri.org/|\u062a\u0627\u0631\u064a\u062e-\u0627\u0644\u0648\u0635\u0648\u0644=2025-01-18|\u0635\u062d\u064a\u0641\u0629=milexdata.sipri.org|\u0644\u063a\u0629=en|\u0645\u0633\u0627\u0631 \u0623\u0631\u0634\u064a\u0641=http://web.archive.org/web/20210325144504/http://www.milexdata.sipri.org/|\u062a\u0627\u0631\u064a\u062e \u0623\u0631\u0634\u064a\u0641=2021-03-25}}</ref> \u0648\u0641\u064a [[\u0623\u063a\u0633\u0637\u0633]] [[1994]] \u0648\u0642\u0639\u062a \u0642\u0637\u0631 \u0645\u064a\u062b\u0627\u0642 \u062f\u0641\u0627\u0639\u064a \u0645\u0639 [[\u0641\u0631\u0646\u0633\u0627]] \u0645\u0642\u0627\u0628\u0644 \u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629 \u0639\u0644\u0649 \u0634\u0631\u0627\u0621 12 \u0637\u0627\u0626\u0631\u0629 [[\u0645\u064a\u0631\u0627\u062c (\u062a\u0648\u0636\u064a\u062d)|\u0645\u064a\u0631\u0627\u062c]] 5-2000 (Mirage 2000-5 EDA/DDA) \u0643\u0645\u0627 \u0648\u0642\u0639\u062a \u0645\u0624\u062e\u0631\u0627\u064b \u0627\u062a\u0641\u0627\u0642\u0627\u062a \u062f\u0641\u0627\u0639\u064a\u0629 \u0645\u0639 [[\u0627\u0644\u0648\u0644\u0627\u064a\u0627\u062a \u0627\u0644\u0645\u062a\u062d\u062f\u0629]] \u0648[[\u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u0627\u0644\u0645\u062a\u062d\u062f\u0629]]\u060c \u0643\u0645\u0627 \u062a\u0644\u0639\u0628 \u062f\u0648\u0631 \u0646\u0634\u0637 \u0627\u0644\u062c\u0647\u0648\u062f \u0627\u0644\u062f\u0641\u0627\u0639\u064a\u0629 \u0644[[\u0645\u062c\u0644\u0633 \u0627\u0644\u062a\u0639\u0627\u0648\u0646 \u0644\u062f\u0648\u0644 \u0627\u0644\u062e\u0644\u064a\u062c \u0627\u0644\u0639\u0631\u0628\u064a\u0629|\u0645\u062c\u0644\u0633 \u0627\u0644\u062a\u0639\u0627\u0648\u0646 \u0627\u0644\u062e\u0644\u064a\u062c\u064a]] \u0648\u0627\u062f\u062a \u062f\u0648\u0631 \u0647\u0627\u0645 \u0623\u062b\u0646\u0627\u0621 [[\u062d\u0631\u0628 \u0627\u0644\u062e\u0644\u064a\u062c (\u062a\u0648\u0636\u064a\u062d)|\u062d\u0631\u0628 \u0627\u0644\u062e\u0644\u064a\u062c]] \u0648\u062e\u0627\u0635\u0647 [[\u0645\u0639\u0631\u0643\u0629 \u0627\u0644\u062e\u0641\u062c\u064a]].\n\n== \u0623\u0641\u0631\u0639 \u0627\u0644\u0642\u0648\u0627\u062a \u0627\u0644\u0642\u0637\u0631\u064a\u0629 ==\n* [[\u0627\u0644\u0642\u0648\u0627\u062a \u0627\u0644\u0628\u0631\u064a\u0629 \u0627\u0644\u0623\u0645\u064a\u0631\u064a\u0629 \u0627\u0644\u0642\u0637\u0631\u064a\u0629|\u0627\u0644\u0642\u0648\u0627\u062a \u0627\u0644\u0628\u0631\u064a\u0629 \u0627\u0644\u0642\u0637\u0631\u064a\u0629]]\n* [[\u0627\u0644\u0642\u0648\u0627\u062a \u0627\u0644\u0628\u062d\u0631\u064a\u0629 \u0627\u0644\u0623\u0645\u064a\u0631\u064a\u0629 \u0627\u0644\u0642\u0637\u0631\u064a\u0629|\u0627\u0644\u0642\u0648\u0627\u062a \u0627\u0644\u0628\u062d\u0631\u064a\u0629 \u0627\u0644\u0642\u0637\u0631\u064a\u0629]]\n* [[\u0627\u0644\u0642\u0648\u0627\u062a \u0627\u0644\u062c\u0648\u064a\u0629 \u0627\u0644\u0623\u0645\u064a\u0631\u064a\u0629 \u0627\u0644\u0642\u0637\u0631\u064a\u0629|\u0627\u0644\u0642\u0648\u0627\u062a \u0627\u0644\u062c\u0648\u064a\u0629 \u0627\u0644\u0642\u0637\u0631\u064a\u0629]]\n* [[\u0642\u0648\u0627\u062a \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u062c\u0648\u064a \u0627\u0644\u0623\u0645\u064a\u0631\u064a \u0627\u0644\u0642\u0637\u0631\u064a|\u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u062c\u0648\u064a \u0627\u0644\u0642\u0637\u0631\u064a]]\n* \u0627\u0644\u0634\u0631\u0637\u0629 \u0627\u0644\u0639\u0633\u0643\u0631\u064a\u0629\n* \u0627\u0644\u0642\u0648\u0627\u062a \u0627\u0644\u062e\u0627\u0635\u0629 \u0627\u0644\u0642\u0637\u0631\u064a\u0629\n\n== \u0627\u0644\u0625\u0646\u0641\u0627\u0642 \u0627\u0644\u0639\u0633\u0643\u0631\u064a ==\n\u0628[[\u062f\u0648\u0644\u0627\u0631|\u0627\u0644\u062f\u0648\u0644\u0627\u0631]] \u0627\u0644\u0623\u0645\u0631\u064a\u0643\u064a \u062d\u0648\u0627\u0644\u064a 816 [[\u0645\u0644\u064a\u0648\u0646]] (\u0644\u0644\u0633\u0646\u0629 99-[[2000]]) \u0645\u0646 \u0646\u0645\u0648 [[\u0646\u0627\u062a\u062c \u0645\u062d\u0644\u064a \u0625\u062c\u0645\u0627\u0644\u064a|\u0627\u0644\u0646\u0627\u062a\u062c \u0627\u0644\u0645\u062d\u0644\u064a]] 8.1% (\u0644\u0644\u0633\u0646\u0629 99-2000). \u0627\u0644\u062d\u0643\u0648\u0645\u0629 \u0627\u0644\u0642\u0637\u0631\u064a\u0629 \u0623\u0646\u0641\u0642\u062a \u062d\u0648\u0627\u0644\u064a 2,91 \u0645\u0644\u064a\u0627\u0631 \u062f\u0648\u0644\u0627\u0631 \u0623\u0645\u0631\u064a\u0643\u064a \u0639\u0644\u0649 \u0642\u0637\u0627\u0639 \u0627\u0644\u062f\u0641\u0627\u0639 \u0641\u064a \u0639\u0627\u0645 [[2005]]\u060c \u0645\u0642\u0627\u0631\u0646\u0629 \u0628\u0645\u062a\u0648\u0633\u0637 \u0625\u0646\u0641\u0627\u0642 \u0645\u0644\u064a\u0627\u0631 \u062f\u0648\u0644\u0627\u0631 \u0633\u0646\u0648\u064a\u0627 \u0641\u064a \u0623\u0648\u0627\u0626\u0644 \u0627\u0644\u062a\u0633\u0639\u064a\u0646\u064a\u0627\u062a. \u0642\u0637\u0631 \u0627\u0633\u062a\u0646\u0641\u0630\u062a 32.5 % \u0645\u0646 \u0623\u062c\u0645\u0627\u0644\u064a \u0625\u0646\u0641\u0627\u0642\u0647\u0627 \u0641\u064a \u0627\u0644\u0641\u062a\u0631\u0629 \u0628\u064a\u0646 [[2000]] \u0648[[2004]] \u0644\u0635\u0627\u0644\u062d \u0642\u0648\u0627\u062a\u0647\u0627 \u0627\u0644\u0639\u0633\u0643\u0631\u064a\u0629\u060c \u0648\u062a\u0644\u0643 \u062b\u0627\u0644\u062b \u0623\u0643\u0628\u0631 \u0646\u0633\u0628\u0629 \u0625\u0646\u0641\u0627\u0642 \u062f\u0641\u0627\u0639\u064a \u0641\u064a \u0627\u0644\u0639\u0627\u0644\u0645 \u0627\u0644\u0639\u0631\u0628\u064a (\u064a\u0633\u0628\u0642\u0647\u0627 \u0639\u0645\u0627\u0646 \u062b\u0645 \u0627\u0644\u0628\u062d\u0631\u064a\u0646).\n\n\u0641\u0627\u0633\u062a\u064a\u0631\u0627\u062f [[\u0642\u0637\u0631]] \u0644\u0644\u0633\u0644\u0627\u062d \u0648\u0627\u0644\u0645\u0639\u062f\u0627\u062a \u0627\u0644\u0639\u0633\u0643\u0631\u064a\u0629 \u0634\u0647\u062f \u0627\u0646\u062e\u0641\u0627\u0636\u0627 \u0645\u0644\u062d\u0648\u0638\u0627 \u0641\u064a \u0627\u0644\u0633\u0646\u0648\u0627\u062a \u0627\u0644\u0645\u0627\u0636\u064a\u0629\u060c \u0641\u0641\u064a \u0639\u0627\u0645 [[1994]] \u0627\u0633\u062a\u0648\u0631\u062f\u062a \u0627\u0644\u062d\u0643\u0648\u0645\u0629 \u0627\u0644\u0642\u0637\u0631\u064a\u0629 \u0633\u0644\u0627\u062d \u0628\u0642\u064a\u0645\u0629 1,3 \u0645\u0644\u064a\u0627\u0631 \u062f\u0648\u0644\u0627\u0631\u060c \u0648625 \u0645\u0644\u064a\u0648\u0646 \u0639\u0627\u0645 1997\u060c \u0648\u0645\u0644\u064a\u0627\u0631 \u0648\u0627\u062d\u062f\u0627 \u0641\u064a 1999\u060c \u0648\u0644\u0643\u0646 \u0645\u062a\u0648\u0633\u0637 \u0642\u064a\u0645\u0629 \u0627\u0633\u062a\u064a\u0631\u0627\u062f \u0627\u0644\u0633\u0644\u0627\u062d \u0641\u064a \u0627\u0644\u0623\u0639\u0648\u0627\u0645 \u0627\u0644\u0633\u0627\u0628\u0642\u0629 \u0627\u0646\u062e\u0641\u0636\u062a \u0644\u0623\u0642\u0644 \u0645\u0646 50 \u0645\u0644\u064a\u0648\u0646 \u062f\u0648\u0644\u0627\u0631 \u0641\u064a \u0627\u0644\u0633\u0646\u0629. \u0648\u062a\u0623\u062a\u064a 80 % \u0645\u0646 \u0627\u0644\u0645\u0648\u0627\u0631\u062f \u0627\u0644\u0622\u0644\u064a\u0629 \u0644\u0644\u0642\u0648\u0627\u062a \u0627\u0644\u0642\u0637\u0631\u064a\u0629 \u0627\u0644\u0645\u0633\u0644\u062d\u0629 \u0645\u0646 [[\u0641\u0631\u0646\u0633\u0627]]\u060c \u0648\u0625\u0646 \u0634\u0647\u062f\u062a \u0627\u0644\u0633\u0646\u0648\u0627\u062a \u0627\u0644\u0645\u0627\u0636\u064a\u0629 \u0627\u0631\u062a\u0641\u0627\u0639\u0627 \u0641\u064a \u0627\u0644\u062a\u0639\u0627\u0648\u0646 \u0627\u0644\u0642\u0637\u0631\u064a-\u0627\u0644\u0623\u0645\u0631\u064a\u0643\u064a \u0648\u0627\u0644\u0642\u0637\u0631\u064a-\u0627\u0644\u0628\u0631\u064a\u0637\u0627\u0646\u064a \u0641\u064a \u0645\u062c\u0627\u0644 \u0627\u0644\u062f\u0641\u0627\u0639. \u0648\u0641\u064a \u0627\u0644\u0648\u0642\u062a \u0627\u0644\u062d\u0627\u0644\u064a \u062a\u062d\u0627\u0648\u0644 [[\u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u0627\u0644\u0645\u062a\u062d\u062f\u0629|\u0628\u0631\u064a\u0637\u0627\u0646\u064a\u0627]] \u0625\u062a\u0645\u0627\u0645 \u0635\u0641\u0642\u0629 \u0645\u0639 \u0627\u0644\u062d\u0643\u0648\u0645\u0629 \u0627\u0644\u0642\u0637\u0631\u064a\u0629 \u0644\u062a\u0632\u0648\u064a\u062f\u0647\u0627 \u0628\u0637\u064a\u0627\u0631\u0627\u062a \u0627\u0644\u0647\u0648\u0643 \u0627\u0644\u062d\u0631\u0628\u064a\u0629 Hawk training/fighting aircraft. \u0648\u0645\u0646 \u0627\u0644\u062c\u062f\u064a\u0631 \u0628\u0627\u0644\u0630\u0643\u0631 \u0623\u0646 \u0628\u0631\u064a\u0637\u0627\u0646\u064a\u0627 \u0643\u0627\u0646\u062a \u0642\u062f \u0648\u0631\u062f\u062a \u0644\u0642\u0637\u0631 \u062d\u0627\u0645\u0644\u0627\u062a \u0623\u0641\u0631\u0627\u062f \u0645\u062f\u0631\u0639\u0629 \u0645\u0646 \u0637\u0631\u0627\u0632 \u0628\u064a\u0631\u0646\u0627 Piranha Armored Personnel Carrier \u0648\u0642\u0648\u0627\u0631\u0628 \u0627\u0644\u062f\u0648\u0631\u064a\u0629 \u0627\u0644\u0633\u0631\u064a\u0639\u0629 \u0645\u0646 \u0637\u0631\u0627\u0632 \u0641\u064a\u062a\u0627 Vita fast patrol craft. \u0648\u0627\u0644\u0648\u0644\u0627\u064a\u0627\u062a \u0627\u0644\u0645\u062a\u062d\u062f\u0629 \u062a\u0642\u062f\u0645\u062a \u0644\u0642\u0637\u0631 \u0628\u0639\u0631\u0636 \u0644\u0628\u064a\u0639 \u0637\u0627\u0626\u0631\u0627\u062a \u0627\u0644\u0640 F-16 \u0648\u0646\u0638\u0627\u0645 \u0627\u0644\u0628\u064a\u062a\u0631\u064a\u0648\u062a \u0644\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u062c\u0648\u064a Patriot air defense system.\n\u0648\u0627\u0644\u062c\u064a\u0634 \u0627\u0644\u0642\u0637\u0631\u064a \u064a\u062a\u0643\u0648\u0646 \u0645\u0646 36,000 \u0641\u0631\u062f \u0648\u0630\u0644\u0643 \u064a\u0639\u062f \u062d\u062c\u0645\u0627 \u062c\u064a\u062f\u0627 \u0628\u0627\u0644\u0646\u0633\u0628\u0629 \u0644\u0644\u0627\u062d\u062a\u064a\u062c\u0627\u062a \u062f\u0648\u0644\u0629 \u0642\u0637\u0631. \u0628\u0627\u0644\u0627\u0636\u0627\u0641\u0647 \u0625\u0644\u0649 \u0630\u0644\u0643 \u0623\u0646 \u062f\u0648\u0644\u0629 \u0642\u0637\u0631 \u062a\u062a\u0645\u062a\u0639 \u0628\u062d\u0645\u0627\u064a\u0629 \u0623\u0645\u0631\u064a\u0643\u064a\u0629 \u0628\u062d\u0643\u0645 \u062a\u0648\u0627\u062c\u062f \u0642\u0627\u0639\u062f\u0629 \u0644\u0644\u0642\u0648\u0627\u062a \u0627\u0644\u0623\u0645\u0631\u064a\u0643\u064a\u0629 \u062f\u0627\u062e\u0644 \u0627\u0644\u0628\u0644\u0627\u062f. \u0623\u0645\u0627 \u0639\u0646 \u0627\u0644\u0645\u0639\u062f\u0627\u062a \u0627\u0644\u0639\u0633\u0643\u0631\u064a\u0629\u060c \u0641\u0646\u062c\u062f \u0623\u0646 \u0645\u0648\u0627\u0631\u062f \u0627\u0644\u062c\u064a\u0634 \u0627\u0644\u0622\u0644\u064a\u0629 \u0645\u062a\u0648\u0627\u0636\u0639\u0629 \u0627\u0644\u062d\u062c\u0645 \u0648\u0641\u064a \u0628\u0639\u0636 \u0627\u0644\u0623\u062d\u064a\u0627\u0646 \u0645\u062d\u062f\u0648\u062f\u0629 \u0627\u0644\u062c\u0648\u062f\u0629\u060c \u0641\u0639\u0644\u0649 \u0633\u0628\u064a\u0644 \u0627\u0644\u0645\u062b\u0627\u0644 \u0627\u0644\u062f\u0628\u0627\u0628\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u0645\u062a\u0644\u0643\u0647\u0627 \u0627\u0644\u0642\u0648\u0627\u062a \u0627\u0644\u0642\u0637\u0631\u064a\u0629 (30 [[\u062f\u0628\u0627\u0628\u0629]] \u0645\u0646 \u0637\u0631\u0627\u0632 [[\u0623\u064a \u0623\u0645 \u0623\u0643\u0633-30]]) \u0648\u0644\u0643\u0646 \u062a\u0645 \u062d\u062f\u064a\u062b\u0627 \u0627\u0636\u0627\u0641\u0647 \u062f\u0628\u0627\u0628\u0627\u062a [[:en:Leopard 2|\u0644\u064a\u0648\u0628\u0627\u0631\u062f]] \u0627\u0644\u0623\u0644\u0645\u0627\u0646\u064a\u0629 \u0627\u0644\u0635\u0646\u0639 \u0644\u0644\u062e\u062f\u0645\u0647 \u0641\u064a \u0627\u0644\u0642\u0648\u0627\u062a \u0627\u0644\u0645\u0633\u0644\u062d\u0629 \u0627\u0644\u0642\u0637\u0631\u064a\u0629<ref>{{\u0627\u0633\u062a\u0634\u0647\u0627\u062f \u0628\u062e\u0628\u0631\n| \u0645\u0633\u0627\u0631 = https://defence-blog.com/news/army/photos-qatars-leopard-2a7-main-battle-tank.html\n| \u0639\u0646\u0648\u0627\u0646 = Photos: Qatar's Leopard 2A7+ main battle tank - Defence Blog\n| \u062a\u0627\u0631\u064a\u062e = 2017-12-18\n| \u0635\u062d\u064a\u0641\u0629 = Defence Blog\n| \u0644\u063a\u0629 = en-US\n| \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0648\u0635\u0648\u0644 = 2018-06-11\n| \u0645\u0633\u0627\u0631 \u0623\u0631\u0634\u064a\u0641 = https://web.archive.org/web/20180712030027/https://defence-blog.com/army/photos-qatars-leopard-2a7-main-battle-tank.html | \u062a\u0627\u0631\u064a\u062e \u0623\u0631\u0634\u064a\u0641 = 12 \u064a\u0648\u0644\u064a\u0648 2018 }}</ref> \u0648\u0647\u064a \u062a\u0639\u062a\u0628\u0631 \u0625\u062d\u062f\u0649 \u0627\u062d\u062f\u062b \u0648\u0627\u0642\u0648\u0649 \u0627\u0644\u062f\u0628\u0627\u0628\u0627\u062a \u0641\u064a \u0627\u0644\u0639\u0627\u0644\u0645. \u0648\u0641\u064a \u0627\u0644\u0648\u0642\u062a \u0646\u0641\u0633\u0647 \u064a\u062a\u0645\u064a\u0632 \u0627\u0644\u062c\u0646\u0648\u062f \u0627\u0644\u0642\u0637\u0631\u064a\u0648\u0646 \u0628\u062a\u062f\u0631\u064a\u0628 \u062c\u064a\u062f. \u0648\u0641\u064a \u062a\u0627\u0631\u064a\u062e 18 \u0645\u0646 \u062f\u064a\u0633\u0645\u0628\u0631 \u0644\u0639\u0627\u0645 2017 \u062a\u0645 \u0627\u0644\u0643\u0634\u0641 \u0644\u0644\u0627\u0648\u0644 \u0645\u0631\u0647 \u0639\u0646 \u0645\u0646\u0638\u0648\u0645\u0647 \u0635\u0648\u0627\u0631\u064a\u062e \u0628\u0627\u0644\u064a\u0633\u062a\u064a\u0629 SY400 \u0635\u064a\u0646\u064a\u0647 \u0627\u0644\u0635\u0646\u0639<ref>{{\u0627\u0633\u062a\u0634\u0647\u0627\u062f \u0628\u0648\u064a\u0628\n| \u0645\u0633\u0627\u0631 = https://defense-update.com/20171218_qatar_sy400.html\n| \u0639\u0646\u0648\u0627\u0646 = Qatar Acquires Ballistic Missiles from China {{!}} Defense Update:\n| \u0645\u0648\u0642\u0639 = defense-update.com\n| \u0644\u063a\u0629 = en-US\n| \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0648\u0635\u0648\u0644 = 2018-06-11\n| \u0645\u0633\u0627\u0631 \u0623\u0631\u0634\u064a\u0641 = https://web.archive.org/web/20180825115410/https://defense-update.com/20171218_qatar_sy400.html | \u062a\u0627\u0631\u064a\u062e \u0623\u0631\u0634\u064a\u0641 = 25 \u0623\u063a\u0633\u0637\u0633 2018 }}</ref> \u0641\u064a \u0627\u0644\u0639\u0631\u0636 \u0627\u0644\u0639\u0633\u0643\u0631\u064a \u0641\u064a [[\u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0648\u0637\u0646\u064a \u0644\u0642\u0637\u0631|\u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u0648\u0637\u0646\u064a]]. \u0645\u0646\u0638\u0648\u0645\u0647 \u0627\u0644\u0635\u0648\u0627\u0631\u064a\u062e \u0627\u0644\u0628\u0627\u0644\u064a\u0633\u062a\u064a\u0629 SY400 \u062a\u0639\u062a\u0628\u0631 \u0645\u0646\u0638\u0648\u0645\u0647 \u0645\u062a\u0637\u0648\u0631\u0647 \u0630\u0627\u062a \u0645\u062f\u0649 400 \u0643\u064a\u0644\u0648 \u0645\u062a\u0631.\n\n\u0648\u0633\u0644\u0627\u062d \u0627\u0644\u0637\u064a\u0631\u0627\u0646 \u0627\u0644\u0642\u0637\u0631\u064a \u0644\u0645 \u064a\u0645\u0631 \u0628\u062a\u063a\u064a\u0631\u0627\u062a \u0645\u0644\u062d\u0648\u0638\u0629 \u0645\u0646\u0630 \u0628\u062f\u0627\u064a\u0629 \u0627\u0644\u062a\u0633\u0639\u064a\u0646\u064a\u0627\u062a\u060c \u0628\u0627\u0633\u062a\u062b\u0646\u0627\u0621 \u0632\u064a\u0627\u062f\u0629 \u0641\u064a \u0639\u062f\u062f \u0637\u0627\u0626\u0631\u0627\u062a \u0627\u0644\u0646\u0642\u0644. \u0641\u0623\u0646 \u062a\u062f\u0631\u064a\u0628 \u0637\u064a\u0627\u0631\u064a \u0627\u0644\u0633\u0644\u0627\u062d \u0627\u0644\u062c\u0648\u064a \u064a\u0624\u0647\u0644\u0647\u0645 \u0644\u0644\u0642\u064a\u0627\u0645 \u0628\u0645\u0647\u0645\u0627\u062a \u0628\u0633\u064a\u0637\u0629 \u0648\u0644\u0643\u0646 \u0633\u0644\u0627\u062d \u0627\u0644\u0637\u064a\u0631\u0627\u0646 \u0644\u064a\u0633 \u0645\u062c\u0647\u0632\u0627 \u0644\u0644\u0642\u064a\u0627\u0645 \u0628\u0623\u0646\u0634\u0637\u0629 \u0639\u0633\u0643\u0631\u064a\u0629 \u062c\u0627\u062f\u0629 \u0628\u062f\u0648\u0646 \u0645\u0633\u0627\u0639\u062f\u0627\u062a \u062e\u0627\u0631\u062c\u064a\u0629. \u062d\u064a\u062b \u0639\u0642\u062f\u062a \u0642\u0637\u0631 \u0635\u0641\u0642\u0629 \u0645\u0639 [[\u0627\u0644\u0647\u0646\u062f]] \u0644\u0628\u064a\u0639 \u0637\u0627\u0626\u0631\u062a\u0647\u0627 \u0627\u0644\u0645\u064a\u0631\u0627\u062c Mirage 200-5 multi-role aircraft \u062a\u0631\u0642\u0628\u0627 \u0644\u0635\u0641\u0642\u0629 \u0645\u062d\u062a\u0645\u0644\u0629 \u0644\u0634\u0631\u0627\u0621 \u0637\u0627\u0626\u0631\u0627\u062a \u0627\u0644\u0640 F-16.\n\n\u0648\u062a\u0645\u062a\u0644\u0643 \u0627\u0644\u0642\u0648\u0627\u062a \u0627\u0644\u0642\u0637\u0631\u064a\u0629 \u0646\u0638\u0627\u0645 \u062f\u0641\u0627\u0639 \u062c\u0648\u064a \u0648\u0644\u0643\u0646\u0647 \u0644\u0627 \u064a\u0634\u0645\u0644 \u0623\u064a\u0629 [[\u0635\u0627\u0631\u0648\u062e \u0623\u0631\u0636-\u062c\u0648|\u0635\u0648\u0627\u0631\u064a\u062e \u0623\u0631\u0636-\u062c\u0648]] \u0628\u0639\u064a\u062f\u0629 \u0623\u0648 \u0645\u062a\u0648\u0633\u0637\u0629 \u0627\u0644\u0645\u062f\u0649. \u0648\u0647\u0630\u0647 \u0627\u0644\u0623\u0646\u0638\u0645\u0629 \u062a\u062f\u0627\u0631 \u0628\u0645\u0639\u0631\u0641\u0629 \u0627\u0644\u0633\u0644\u0627\u062d \u0627\u0644\u062c\u0648\u064a \u0648\u062a\u0634\u063a\u0644 \u0628\u0648\u0627\u0633\u0637\u0629 \u0627\u0644\u0642\u0648\u0627\u062a \u0627\u0644\u0628\u0631\u064a\u0629. \u0648\u0646\u0645\u062a\u0644\u0643 [[\u0642\u0637\u0631]] 75 \u0635\u0627\u0631\u0648\u062e \u0623\u0631\u0636 \u062c\u0648.\n\n\u0623\u0645\u0627 \u0627\u0644\u0642\u0648\u0627\u062a \u0627\u0644\u0642\u0637\u0631\u064a\u0629 \u0627\u0644\u0628\u062d\u0631\u064a\u0629 \u062a\u062a\u0643\u0648\u0646 \u0645\u0646 4,000 \u0641\u0631\u062f \u0628\u0645\u0627 \u064a\u062a\u0636\u0645\u0646 \u0631\u062c\u0627\u0644 [[\u0634\u0631\u0637\u0629|\u0627\u0644\u0634\u0631\u0637\u0629]] \u0627\u0644\u0628\u062d\u0631\u064a\u0629 \u0648\u0627\u0644\u0639\u0627\u0645\u0644\u064a\u0646 \u0628\u0648\u062d\u062f\u0627\u062a \u0627\u0644\u062f\u0641\u0627\u0639 \u0627\u0644\u0633\u0627\u062d\u0644\u064a. \u0648\u062a\u0644\u0639\u0628 \u0647\u0630\u0647 \u0627\u0644\u0642\u0648\u0627\u062a \u062f\u0648\u0631\u0627 \u0643\u0628\u064a\u0631\u0627 \u0641\u064a \u062a\u0623\u0645\u064a\u0646 \u0627\u0644\u0645\u0645\u0631\u0627\u062a \u0627\u0644\u0645\u0627\u0626\u064a\u0629 \u0627\u0644\u062a\u064a \u062a\u0639\u062a\u0645\u062f \u0639\u0644\u064a\u0647\u0627 \u0642\u0637\u0631 \u0644\u062a\u0635\u062f\u064a\u0631 \u0627\u0644\u0646\u0641\u0637 \u0648\u0627\u0644\u0645\u0648\u0627\u0631\u062f \u0627\u0644\u0623\u062e\u0631\u0649. \u0648\u0644\u062f\u064a \u0642\u0637\u0631 \u0645\u0627 \u064a\u0642\u0631\u0628 \u0645\u0646 250 \u0632\u0648\u0631\u0642 \u0648\u0642\u0627\u0631\u0628 \u0633\u0631\u064a\u0639\u0629 \u0645\u062c\u0647\u0632\u0629 \u0628\u0642\u062f\u0631\u0629 \u0635\u0627\u0631\u0648\u062e\u064a\u0629 \u062c\u064a\u062f\u0647.\n\n\u0648\u064a\u0634\u064a\u0631 \u0645\u0631\u0643\u0632 \u0627\u0644\u062f\u0631\u0627\u0633\u0627\u062a \u0627\u0644\u0625\u0633\u062a\u0631\u0627\u062a\u064a\u062c\u064a\u0629 \u0648\u0627\u0644\u0639\u0627\u0644\u0645\u064a\u0629 \u0625\u0644\u0649 \u0623\u0646 \u0627\u0644\u0645\u0648\u0627\u0631\u062f \u0627\u0644\u0628\u0634\u0631\u064a\u0629 \u0641\u064a \u0627\u0644\u0642\u0648\u0627\u062a \u0627\u0644\u0628\u062d\u0631\u064a\u0629 \u0632\u0627\u062f\u062a \u0628\u0640 1,100 \u0641\u0631\u062f \u0645\u0646\u0630 \u0639\u0627\u0645 [[1990]]. \u0648\u0628\u0646\u0627\u0621 \u0639\u0644\u0649 \u0627\u0644\u0625\u062d\u0635\u0627\u0626\u064a\u0627\u062a \u0627\u0644\u0645\u0637\u0631\u0648\u062d\u0629 \u064a\u0642\u062f\u0631 \u0627\u0644\u062a\u0642\u0631\u064a\u0631 \u0623\u0646 \u0627\u0644\u0642\u0648\u0627\u062a \u0627\u0644\u0628\u062d\u0631\u064a\u0629 \u0627\u0644\u0642\u0637\u0631\u064a\u0629 \u062a\u062a\u0645\u062a\u0639 \u0628\u0645\u0624\u0647\u0644\u0627\u062a \u0645\u062d\u062f\u0648\u062f\u0629 \u0644\u062e\u0648\u0636 \u0645\u0639\u0627\u0631\u0643 \u062c\u0627\u062f\u0629 \u0648\u0644\u0643\u0646\u0647\u0627 \u0635\u0627\u0644\u062d\u0629 \u0644\u0644\u0642\u064a\u0627\u0645 \u0628\u0627\u0644\u0645\u0647\u0627\u0645 \u0627\u0644\u0644\u0627\u0632\u0645\u0629 \u0644\u0645\u0643\u0627\u0641\u062d\u0629 [[\u0625\u0631\u0647\u0627\u0628|\u0627\u0644\u0625\u0631\u0647\u0627\u0628]] \u0648\u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u062a\u0647\u0631\u064a\u0628.\n\n== \u0645\u0631\u0627\u062c\u0639 ==\n{{\u0645\u0631\u0627\u062c\u0639}}\n\n{{\u062c\u064a\u0648\u0634 \u0639\u0631\u0628\u064a\u0629}}\n{{\u0627\u0644\u0639\u0633\u0643\u0631\u064a\u0629 \u0641\u064a \u0622\u0633\u064a\u0627}}\n{{\u0645\u0648\u0627\u0636\u064a\u0639 \u0642\u0637\u0631}}\n{{\u0631\u0648\u0627\u0628\u0637 \u0634\u0642\u064a\u0642\u0629}}\n{{\u0634\u0631\u064a\u0637 \u0628\u0648\u0627\u0628\u0627\u062a|\u0622\u0633\u064a\u0627|\u0627\u0644\u062d\u0631\u0628|\u0639\u0644\u0648\u0645 \u0639\u0633\u0643\u0631\u064a\u0629|\u0642\u0637\u0631}}\n\n[[\u062a\u0635\u0646\u064a\u0641:\u0627\u0644\u062c\u064a\u0634 \u0627\u0644\u0642\u0637\u0631\u064a]]\n[[\u062a\u0635\u0646\u064a\u0641:\u062c\u064a\u0648\u0634 \u062d\u0633\u0628 \u0627\u0644\u0628\u0644\u062f]]\n[[\u062a\u0635\u0646\u064a\u0641:\u0639\u0633\u0643\u0631\u064a\u0629 \u0642\u0637\u0631]]\n[[\u062a\u0635\u0646\u064a\u0641:\u0642\u0637\u0631]]"}}}]}}}}