  "political_stances": [
    {
      "date": "2026-10-08",
      "topic": "警务改革与公众信任",
      "stance_content": "称公众信任是警队当前最大挑战，警队自2024年8月后已逐步恢复，信任度约恢复六至七成；主张以「零投诉警局」、预防性警务、社区警务，以及发案率、重犯率、起诉质量、结案率、响应时间与公众反馈等指标衡量绩效，重建警民互信。",
      "source": "https://en.prothomalo.com/opinion/interview/99dbk68czv"
    },
    {
      "date": "2026-10-08",
      "topic": "2024年七月起义问责",
      "stance_content": "表示凡有指控即应调查，若证据显示下令、策划、指挥或监督层级存在刑事责任，同样纳入调查范围；强调问责以证据为准而非官职高低。据其称，已有至少150名警察因涉及七月运动期间的强迫失踪与绑架指控被追究，部分在押、部分受审、部分外逃。",
      "source": "https://en.prothomalo.com/opinion/interview/99dbk68czv"
    },
    {
      "date": "2026-10-08",
      "topic": "警务人事去政治化",
      "stance_content": "称已设立专门委员会审核警官任职：凡部长、议员、政界人士、记者或公众推荐人选，推荐人信息一律转交委员会，并由情报机构核查，再按候选人的背景与能力决定任命；并称现政府无人向警方下达非法指令，警方独立办案。",
      "source": "https://en.prothomalo.com/opinion/interview/99dbk68czv"
    },
    {
      "date": "2026-10-26",
      "topic": "执法手段与「交叉火力」",
      "stance_content": "在达卡乔克巴扎尔社区银行活动上称，若有需要且政府允许，警方将实施「交叉火力」；并称警方动用武力被指法西斯、保持克制又被指软弱，同时指责部分记者未获毒资便报道警方无能。言论引发反对党、人权组织和记者团体要求撤回并道歉，警察总部当晚澄清称其仅按字面使用该词，无意主张法外处决。",
      "source": "https://en.prothomalo.com/bangladesh/politics/do96cd89fg"
    },
    {
      "date": "2026-11-20",
      "topic": "基层警民关系",
      "stance_content": "在戈帕尔甘杰视察治安时称，警察局是为民众而设，若民众烧毁警察局、不再需要警察，就须自行维持治安；呼吁当地民众与警方及执法机构合作，共同应对制造动荡者，并称当地整体治安状况良好。",
      "source": "https://en.prothomalo.com/bangladesh/local-news/gjflatovbc"
    }
  ],
