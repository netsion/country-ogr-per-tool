  "political_stances": [
    {
      "topic": "医疗改革：适当与价值驱动护理",
      "stance_content": "强调将质量、安全和价值统一整合为医疗体系的核心优先事项，推动适当与价值驱动护理(AVBC)作为卫生部关键政策方向，包括基于价值的融资、临床和成本效益评估、减少不合理差异和浪费。",
      "source": "https://www.moh.gov.sg/newsroom/speech-by-ms-lai-wei-lin--permanent-secretary--policy---development---ministry-of-health--at-the-nuhs-quality-day--9-february-2026/",
      "date": "2026-02-09"
    },
    {
      "topic": "医疗融资与可持续性",
      "stance_content": "关注医疗费用的可负担性和可持续性，通过健康科技评估(ACE)推动临床和成本效益评估，与制药企业协商以扩大药品补贴覆盖范围，确保医疗体系财政可持续。",
      "source": "https://www.moh.gov.sg/newsroom/speech-by-ms-lai-wei-lin--permanent-secretary--policy---development---ministry-of-health--at-the-nuhs-quality-day--9-february-2026/",
      "date": "2026-02-09"
    }
