  "political_stances": [
    {
      "date": "2026-07-20",
      "topic": "伊朗战争与地区局势",
      "stance_content": "认为伊朗战争不存在军事解决方案，战争持续只会严重冲击约旦等美国盟友的经济（旅游业与红海、霍尔木兹海峡航运），并强化伊朗的抵抗意志，最终仍须与伊朗达成政治解决；美国「擅长军事胜利，但不擅长政治和解」。",
      "source": "https://www.pbs.org/newshour/show/iran-war-hurting-u-s-allies-in-region-former-jordanian-foreign-minister-says"
    },
    {
      "date": "2026-04-04",
      "topic": "美国在中东的调解角色",
      "stance_content": "批评华盛顿在阿以冲突中「从来不是公正的调解人」，而是结构性偏袒以色列的一方；认为当前地区处于以色列军事霸权与美国全面支持之下，缺乏推动公正和平的努力。",
      "source": "https://www.france24.com/ar/%D8%A8%D8%B1%D8%A7%D9%85%D8%AC/%D8%B6%D9%8A%D9%81-%D9%88%D9%85%D8%B3%D9%8A%D8%B1%D8%A9/20260404-%D8%AF-%D9%85%D8%B1%D9%88%D8%A7%D9%86-%D8%A7%D9%84%D9%85%D8%B9%D8%B4%D8%B1-%D8%A7%D9%84%D9%88%D9%84%D8%A7%D9%8A%D8%A7%D8%AA-%D8%A7%D9%84%D9%85%D8%AA%D8%AD%D8%AF%D8%A9-%D9%84%D9%85-%D8%AA%D9%83%D9%86-%D9%8A%D9%88%D9%85%D8%A7-%D9%88%D8%B3%D9%8A%D8%B7%D8%A7-%D9%86%D8%B2%D9%8A%D9%87%D8%A7-%D9%81%D9%8A%D9%85%D8%A7-%D9%8A%D8%AA%D8%B9%D9%84%D9%91%D9%82-%D8%A8%D9%82%D8%B6%D8%A7%D9%8A%D8%A7-%D8%A7%D9%84%D8%B4%D8%B1%D9%82-%D8%A7%D9%84%D8%A3%D9%88%D8%B3%D8%B7"
    },
    {
      "date": "2026-04-04",
      "topic": "亚伯拉罕协议与巴勒斯坦问题",
      "stance_content": "认为把《亚伯拉罕协议》作为美国中东政策近乎唯一的优先事项（拜登与特朗普时期皆然）是重大错误，绕开巴勒斯坦核心问题无法带来真正的地区和平；2023年10月7日事件及随后战争证明了这一路径的脆弱。沙特以「土地换和平」为前提拒绝签署协议的立场值得支持，并可作为更广泛阿拉伯协调的支点。",
      "source": "https://www.france24.com/ar/%D8%A8%D8%B1%D8%A7%D9%85%D8%AC/%D8%B6%D9%8A%D9%81-%D9%88%D9%85%D8%B3%D9%8A%D8%B1%D8%A9/20260404-%D8%AF-%D9%85%D8%B1%D9%88%D8%A7%D9%86-%D8%A7%D9%84%D9%85%D8%B9%D8%B4%D8%B1-%D8%A7%D9%84%D9%88%D9%84%D8%A7%D9%8A%D8%A7%D8%AA-%D8%A7%D9%84%D9%85%D8%AA%D8%AD%D8%AF%D8%A9-%D9%84%D9%85-%D8%AA%D9%83%D9%86-%D9%8A%D9%88%D9%85%D8%A7-%D9%88%D8%B3%D9%8A%D8%B7%D8%A7-%D9%86%D8%B2%D9%8A%D9%87%D8%A7-%D9%81%D9%8A%D9%85%D8%A7-%D9%8A%D8%AA%D8%B9%D9%84%D9%91%D9%82-%D8%A8%D9%82%D8%B6%D8%A7%D9%8A%D8%A7-%D8%A7%D9%84%D8%B4%D8%B1%D9%82-%D8%A7%D9%84%D8%A3%D9%88%D8%B3%D8%B7"
    },
    {
      "date": "2026-04-04",
      "topic": "阿拉伯政治改革",
      "stance_content": "强调政治改革「不是政治奢侈品，而是地区美好未来的必需」：依赖租金型经济模式的阿拉伯国家，若不让民众真正参与决策，将无法在石油重要性下降后转向生产型经济，公民也不会为艰难转型承担代价。",
      "source": "https://www.france24.com/ar/%D8%A8%D8%B1%D8%A7%D9%85%D8%AC/%D8%B6%D9%8A%D9%81-%D9%88%D9%85%D8%B3%D9%8A%D8%B1%D8%A9/20260404-%D8%AF-%D9%85%D8%B1%D9%88%D8%A7%D9%86-%D8%A7%D9%84%D9%85%D8%B9%D8%B4%D8%B1-%D8%A7%D9%84%D9%88%D9%84%D8%A7%D9%8A%D8%A7%D8%AA-%D8%A7%D9%84%D9%85%D8%AA%D8%AD%D8%AF%D8%A9-%D9%84%D9%85-%D8%AA%D9%83%D9%86-%D9%8A%D9%88%D9%85%D8%A7-%D9%88%D8%B3%D9%8A%D8%B7%D8%A7-%D9%86%D8%B2%D9%8A%D9%87%D8%A7-%D9%81%D9%8A%D9%85%D8%A7-%D9%8A%D8%AA%D8%B9%D9%84%D9%91%D9%82-%D8%A8%D9%82%D8%B6%D8%A7%D9%8A%D8%A7-%D8%A7%D9%84%D8%B4%D8%B1%D9%82-%D8%A7%D9%84%D8%A3%D9%88%D8%B3%D8%B7"
    },
    {
      "date": "2026-04-04",
      "topic": "约以和平条约",
      "stance_content": "强调约旦与以色列签署和平条约的本质在于保卫约旦边界、防止巴勒斯坦人被驱逐到约旦领土，并防止巴勒斯坦问题以牺牲约旦利益的方式解决；早在驻以任内即警告，若无对巴和平，约以和平将只是「政府间的和平而非人民间的和平」。",
      "source": "https://www.france24.com/ar/%D8%A8%D8%B1%D8%A7%D9%85%D8%AC/%D8%B6%D9%8A%D9%81-%D9%88%D9%85%D8%B3%D9%8A%D8%B1%D8%A9/20260404-%D8%AF-%D9%85%D8%B1%D9%88%D8%A7%D9%86-%D8%A7%D9%84%D9%85%D8%B9%D8%B4%D8%B1-%D8%A7%D9%84%D9%88%D9%84%D8%A7%D9%8A%D8%A7%D8%AA-%D8%A7%D9%84%D9%85%D8%AA%D8%AD%D8%AF%D8%A9-%D9%84%D9%85-%D8%AA%D9%83%D9%86-%D9%8A%D9%88%D9%85%D8%A7-%D9%88%D8%B3%D9%8A%D8%B7%D8%A7-%D9%86%D8%B2%D9%8A%D9%87%D8%A7-%D9%81%D9%8A%D9%85%D8%A7-%D9%8A%D8%AA%D8%B9%D9%84%D9%91%D9%82-%D8%A8%D9%82%D8%B6%D8%A7%D9%8A%D8%A7-%D8%A7%D9%84%D8%B4%D8%B1%D9%82-%D8%A7%D9%84%D8%A3%D9%88%D8%B3%D8%B7"
    }
  ],
