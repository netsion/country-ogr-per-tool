  "political_stances": [
    {
      "date": "2025",
      "topic": "生成AI行政应用",
      "stance_content": "主张政府应率先应用生成AI技术以应对人口减少导致的公共服务人力不足，推动数字厅构建「源内」生成AI利用环境并向各府省厅展开。认为在「隗より始めよ」（从自身做起）理念下，政府应成为AI利活用的旗手，并强调需在安全与效果之间取得平衡，设立先进AI利活用 Advisory Board 对高影响案件提供助言。",
      "source": "https://digital-gov.note.jp/n/ndca41ee952df"
    },
    {
      "date": "2021",
      "topic": "数字化政策理念",
      "stance_content": "主张数字厅应作为「各府省厅的协作伙伴」而非仅指示者，秉持「Government as a Service」「Government as a Startup」理念，尊重各省厅所管法令制度，以创业公司的紧张感和使命感共同推动数字化转型。强调「数字不是目的而是手段」，核心目标是在人口减少约束下维持公共服务、应对高龄化和灾害等社会课题。",
      "source": "https://digital-gov.note.jp/n/ndca41ee952df"
    }
  ],
