  "political_stances": [
    {
      "topic": "社会福利与福利政策",
      "stance_content": "作为福利委员会主席，罗霍·皮门特尔致力于推动社会公正和福利政策的完善，主张加强社会保障体系，确保福利项目的有效性和包容性。她提出将每年11月13日设立为\"国家福利日\"，以纪念墨西哥社会福利事业的进步。"
    },
    {
      "topic": "儿童权利保护",
      "stance_content": "提出改革《儿童和青少年权利一般法》第103条的倡议，加强儿童权益的法律保障。"
    },
    {
      "topic": "宪法改革与社会权利",
      "stance_content": "支持改革宪法第4条和第27条，将福利和社会保障确立为宪法权利，推动社会权利的宪法化进程。"
    },
    {
      "topic": "劳工权利",
      "stance_content": "作为劳工党成员，积极支持工会运动和劳工权益，曾公开声援墨西哥城教育工作者工会(SUTIEMS)的诉求。"
    },
    {
      "topic": "外交关系",
      "stance_content": "曾代表劳工党出席中美洲议会和拉美政党常设会议，推动墨西哥与拉丁美洲国家之间的议会交流与合作，特别关注越南等国的关系发展。"
    }
  ],
